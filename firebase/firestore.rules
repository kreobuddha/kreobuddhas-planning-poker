rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.adminId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.adminId == request.auth.uid;

      match /participants/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && uid == request.auth.uid;
      }

      match /rounds/{roundId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() &&
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.adminId == request.auth.uid;

        // Vote values are hidden until the round is revealed, or it's your own vote.
        match /votes/{uid} {
          allow read: if isSignedIn() && (
            uid == request.auth.uid ||
            get(/databases/$(database)/documents/sessions/$(sessionId)/rounds/$(roundId)).data.revealed == true
          );
          allow write: if isSignedIn() && uid == request.auth.uid;
        }

        // Tracks WHO has voted (no value) so the UI can show progress before reveal.
        match /voteStatus/{uid} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && uid == request.auth.uid;
        }
      }
    }
  }
}
