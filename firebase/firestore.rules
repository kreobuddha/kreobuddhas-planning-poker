rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Mirrors CARD_DECKS in src/config.ts — rules can't import it, so both sides must be
    // edited together when a deck is added, renamed, or rescaled.
    function deckValues(deck) {
      return deck == 'fibonacci' ? [1, 2, 3, 5, 8, 13, 21]
           : deck == 'powers' ? [1, 2, 4, 8, 16, 32]
           : [0.5, 1, 2, 3, 5, 8, 13, 20];
    }

    function isKnownDeck(deck) {
      return deck in ['fibonacci', 'modified', 'powers'];
    }

    match /sessions/{sessionId} {
      function session() {
        return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      }

      function isAdmin() {
        return isSignedIn() && session().adminId == request.auth.uid;
      }

      // A room stops accepting writes once its deadline passes — this is the server-side
      // boundary, not the UI hint that precedes it. Reads stay open, because an expired room
      // still has to be able to say that it expired.
      //
      // Sessions created before lifetimes existed carry no `expiresAt`. They keep working
      // instead of dying the moment this rule ships.
      //
      // The `!exists` arm is not a loophole, it is the create path. A room is created as one
      // batch — the session document and its admin's participant row together, so a room can
      // never exist with nobody able to join it. Rules evaluate each write in a batch
      // independently and against the state *before* it, so while that batch is being checked
      // the session document does not exist yet and `session()` reads nothing. Without this arm
      // the participant row is refused, the whole batch rolls back, and no room can be created
      // at all — which is exactly what shipped in 0.3.0. Writing a participant row under a
      // session id that does not exist was equally possible before deadlines existed; it strands
      // a row nobody reads, and creates nothing.
      function isLive() {
        return !exists(/databases/$(database)/documents/sessions/$(sessionId))
          || session().get('expiresAt', request.time + duration.value(1, 'h')) > request.time;
      }

      // A session's document id IS its join code, so a room is reached with a direct get.
      // `list` stays denied: it would let any signed-in visitor enumerate every code and walk
      // into any room.
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.code == sessionId
        && isKnownDeck(request.resource.data.deck)
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + maxLifetime()
        && request.resource.data.keys()
             .hasOnly(['code', 'adminId', 'deck', 'createdAt', 'expiresAt']);

      // Six hours, plus a few minutes of slack: the deadline is computed on the client, so a
      // clock running slightly ahead of the server's would otherwise have its own write
      // rejected. Slack this small doesn't move the boundary in any way that matters.
      function maxLifetime() {
        return duration.value(6, 'h') + duration.value(5, 'm');
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Three transitions and nothing else. The code and createdAt are fixed forever, and each
      // branch is a single key, so no two of them can ride along with each other:
      //
      // - the deck, while no round is open (the app enforces the timing, the rules the value);
      // - the deadline, capped ahead but not behind: moving it forward extends the room, moving
      //   it to now is what "close the room" does, which is why closing and expiring are one
      //   state rather than two;
      // - the admin, and only onto somebody who is already a participant — handing the room to
      //   a uid that never joined would strand it exactly as losing the admin does.
      //
      // All three require a live session, so closing and expiring are both terminal: an
      // abandoned room cannot be revived, which is the point of having a deadline at all.
      allow update: if isAdmin() && isLive() && (
        (changedKeys().hasOnly(['deck']) && isKnownDeck(request.resource.data.deck))
        || (changedKeys().hasOnly(['expiresAt'])
            && request.resource.data.expiresAt is timestamp
            && request.resource.data.expiresAt <= request.time + maxLifetime())
        || (changedKeys().hasOnly(['adminId'])
            && exists(/databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.resource.data.adminId)))
      );

      match /participants/{uid} {
        allow read: if isSignedIn();

        // `lastSeenAt` is the presence beat: millis on the writer's own clock, because a pending
        // serverTimestamp() reads back as null and would show the writer as away to itself. The
        // rules bound its shape and nothing else — how stale a beat has to be before the room
        // stops counting on somebody is the client's decision, and being marked away withholds
        // no permission. It is optional so that a row written before presence existed still
        // validates.
        allow write: if isSignedIn() && uid == request.auth.uid && isLive()
          && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'lastSeenAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && (!request.resource.data.keys().hasAny(['lastSeenAt'])
              || request.resource.data.lastSeenAt is number);

        // Leaving, and being shown out. A delete carries no `request.resource`, so it cannot go
        // through the `write` rule above — the field checks there would be evaluated against
        // nothing and deny it. That is why leaving a room was impossible before this rule
        // existed, not a decision anybody made.
        //
        // The admin is allowed to remove somebody because a room fills up with people who closed
        // their laptop and never came back, and presence marks them without clearing them.
        // Nobody else can, and not in a room that has closed: what was voted there is a record.
        allow delete: if isSignedIn() && isLive()
          && (uid == request.auth.uid || isAdmin());
      }

      match /rounds/{roundId} {
        function roundIsOpen() {
          return get(/databases/$(database)/documents/sessions/$(sessionId)/rounds/$(roundId))
            .data.revealed == false;
        }

        allow read: if isSignedIn();

        // A round starts closed and carries nothing but the question and its clock. The size
        // cap matters more than it looks: `question` is echoed to every participant, and the
        // admin is the only writer, so without a bound one room could be made arbitrarily
        // expensive for everyone in it.
        allow create: if isAdmin() && isLive()
          && request.resource.data.keys().hasOnly(['question', 'revealed', 'createdAt'])
          && request.resource.data.question is string
          && request.resource.data.question.size() > 0
          && request.resource.data.question.size() <= 200
          && request.resource.data.revealed == false
          && request.resource.data.createdAt is number;

        // `revealed` is the only thing about a round that ever changes, and it moves both ways:
        // reopening a round is a feature, so a vote can be reconsidered without losing the
        // question. The question itself is frozen — rewriting what was asked after the answers
        // are in would make the record a lie.
        allow update: if isAdmin() && isLive()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revealed'])
          && request.resource.data.revealed is bool;

        // Votes are readable by everyone in the session, including before the reveal: the UI
        // needs the list to show who has voted, and Firestore allows or denies a collection
        // list as a whole — it can't hand back a filtered subset. Hiding the values pre-reveal
        // is therefore the UI's job, not a security boundary: a participant can read them from
        // the network tab. Accepted tradeoff, see README.
        match /votes/{uid} {
          allow read: if isSignedIn();

          // Only your own vote, only while the round is open (so a revealed result can't be
          // rewritten), and only a value that exists in this session's deck — or '?', which
          // belongs to no deck because it is not an estimate. See UNSURE_CARD in src/config.ts.
          allow create, update: if isSignedIn() && uid == request.auth.uid
            && isLive() && roundIsOpen()
            && request.resource.data.keys().hasOnly(['value', 'createdAt'])
            && (request.resource.data.value == '?'
                || request.resource.data.value in deckValues(session().get('deck', 'modified')));

          // Your own vote, always. The admin's reach here is narrow and exists for one job: a
          // participant being removed takes their vote with them, or the revealed cards would
          // name somebody the room no longer has. `roundIsOpen()` still holds for both, so a
          // revealed result cannot be rewritten by either of them — which is why removing
          // somebody is offered only while the round is open.
          allow delete: if isSignedIn() && isLive() && roundIsOpen()
            && (uid == request.auth.uid || isAdmin());
        }
      }
    }
  }
}
